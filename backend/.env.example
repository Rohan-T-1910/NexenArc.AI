# NexenArc Backend Environment Configuration

# Application
APP_NAME=NexenArc
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-insecure-secret-key-for-local-development-only

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# For zero-config local development without Docker:
DATABASE_URL=sqlite+aiosqlite:///nexenarc.db
# For PostgreSQL via Docker compose:
# DATABASE_URL=postgresql+asyncpg://nexenarc:nexenarc_secret@localhost:5432/nexenarc

# Cache & Queue (Redis)
REDIS_URL=redis://localhost:6379/0
